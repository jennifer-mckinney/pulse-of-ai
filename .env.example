# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5434   # Use 5434 to avoid conflict with local Homebrew PostgreSQL on 5432
POSTGRES_DB=pulse_of_ai
POSTGRES_USER=pulse_user
POSTGRES_PASSWORD=changeme_before_production

# ─── Test Database ────────────────────────────────────────────────────────────
POSTGRES_TEST_PORT=5433
POSTGRES_TEST_DB=pulse_of_ai_test

# ─── Application ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Embeddings Service (Python / Infinity) ───────────────────────────────────
EMBEDDINGS_SERVICE_URL=http://localhost:8000

# ─── Data Sources — External APIs ─────────────────────────────────────────────
# Reddit (free — https://www.reddit.com/prefs/apps)
REDDIT_USER_AGENT=pulse-of-ai/1.0 by pulse_monitor

# Twitter/X Basic API ($100/mo — required for search)
# Leave blank to skip; system will log warning and exclude Twitter source
TWITTER_BEARER_TOKEN=

# GitHub Personal Access Token (for GitHub Discussions scraping)
# Leave blank to skip; public repos are accessible without auth at lower rate limits
GITHUB_TOKEN=

# arXiv — no auth required; left here for documentation completeness
# ARXIV_BASE_URL=https://export.arxiv.org/api/query

# Semantic Scholar API (free, 100 req/day unauthenticated; register for higher limits)
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ─── Compaction ───────────────────────────────────────────────────────────────
# Retention window before compaction (days). Default: 90 (3 months)
RETENTION_DETAIL_DAYS=90

# ─── Mapbox ───────────────────────────────────────────────────────────────────
# Public token from https://account.mapbox.com/tokens/
# Served to the browser via GET /api/config — never hardcoded in client JS.
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# ─── Audit Trail ──────────────────────────────────────────────────────────────
# Server-held key for the input_hash exposed by GET /api/audit/:post_id.
# The stored hash is an unsalted SHA-256 of post content, which is offline-
# confirmable for guessable text — so the API exposes HMAC-SHA256(key, hash)
# instead. If unset, input_hash is omitted from responses entirely.
# Generate with: openssl rand -hex 32
AUDIT_HASH_KEY=replace_with_random_64_hex_chars

# ─── Cross-Platform Correlation ───────────────────────────────────────────────
# Deployment-specific salt for verb-noun ID generation. Generate once, never change.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CORRELATION_SALT=replace_with_random_64_hex_chars

# Minimum confidence threshold for assigning a cross-platform pseudonymous ID
CORRELATION_MIN_CONFIDENCE=0.85
