# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5434   # Use 5434 to avoid conflict with local Homebrew PostgreSQL on 5432
POSTGRES_DB=pulse_of_ai
POSTGRES_USER=pulse_user
POSTGRES_PASSWORD=changeme_before_production

# ─── Test Database ────────────────────────────────────────────────────────────
POSTGRES_TEST_PORT=5433
POSTGRES_TEST_DB=pulse_of_ai_test

# ─── Application ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Embeddings Service (Python: FastAPI + sentence-transformers) ─────────────
EMBEDDINGS_SERVICE_URL=http://localhost:8000
# Listen address of the service when run on the host (python/start.sh).
# Default 127.0.0.1: the API is unauthenticated, so it stays off the network.
# Set another address (e.g. 0.0.0.0) only to deliberately serve other machines;
# start.sh warns when it does. Not used by the compose `embeddings` container,
# which listens on the compose network only and publishes no host port.
# EMBEDDINGS_HOST=127.0.0.1
# The model is loaded at a pinned Hugging Face commit (methodology embedding@1.1.0:
# same model and commit as embedding@1.0.0, sentence-transformers 6.1.0).
# Override only deliberately: vectors from another revision are stored with
# methodology_version NULL. The worker also checks the service's GET /health
# before stamping each vector: a service that does not report the registered
# model, revision and library (e.g. a .venv still on an older
# sentence-transformers) gets its vectors stored with methodology_version NULL
# and the mismatch logged; an unreachable /health fails the job (retried).
# EMBED_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# ─── Compaction ───────────────────────────────────────────────────────────────
# Retention window before compaction (days). Default: 90 (3 months).
# A whole number from 30 to 3650: any other value (0, negative, text, "1e3")
# is REJECTED — the retention and compaction steps then fail and remove
# nothing until it is fixed (PR #22 M1).
RETENTION_DETAIL_DAYS=90
# Text windows, run-table retention and the repeatable maintenance job (P10-2, P10-9):
#   MAINTENANCE_EVERY_MS (default 300000: text retention + stale jobs),
#   MAINTENANCE_DAILY_EVERY_MS (default 86400000: compaction + source_runs rollup + the rolling 24 h bias window),
#   MAINTENANCE_TERMS_EVERY_MS (default 604800000: terms-page snapshots),
#   SOURCE_RUNS_RAW_DAYS (30; whole days, minimum 7).
#   RETENTION_OVERDUE_GRACE_MINUTES (default 60, 10..1440): text still stored
#   this long after its window ended opens a critical retention_overdue alert.
#   Compose passes it to the four roles built on the shared x-app anchor
#   (web, worker, migrate, populate), so the worker's alert and /api/health's
#   maintenance.retention_overdue use the same grace. The watchdog (also a Node
#   role, but with its own least-privilege environment) does NOT receive it: it
#   only consumes web's verdict through /api/health.
#   processing_jobs rows are kept permanently (spec §19 Tier 3; PR #22 decision G4).
MAINTENANCE_EVERY_MS=
MAINTENANCE_DAILY_EVERY_MS=
MAINTENANCE_TERMS_EVERY_MS=
RETENTION_OVERDUE_GRACE_MINUTES=
SOURCE_RUNS_RAW_DAYS=
# PostgreSQL pools (P10-12, PR #22 P1-21). PG_POOL_MAX sizes web and the CLI
# scripts run on the host (default 10). Compose passes it to web and to the
# worker; migrate and populate do not get it and keep 10 (the one-shot reserve
# below), and the watchdog is pinned to 2. The worker never sizes its own pool
# from it: it uses it only as web's pool in the budget check below and logs
# that it ignores it. The worker sizes its
# pool from its concurrency (2×COLLECT + 2 + 3×INGEST + EMBED + 3, plus
# CORRELATE while the correlation DPIA gate is open; capped at 60) unless
# WORKER_PG_POOL_MAX is set (a smaller value is logged as short).
# WORKER_REPLICAS (default 1): how many worker processes run. At start the
# worker checks WORKER_REPLICAS × its pool + web + 2 (watchdog) + 10 (one-shot scripts)
# against PostgreSQL's max_connections minus superuser_reserved_connections and
# refuses to start (exit 1) if it exceeds it.
PG_POOL_MAX=
WORKER_PG_POOL_MAX=
WORKER_REPLICAS=
COLLECT_CONCURRENCY=4
INGEST_CONCURRENCY=8
EMBED_CONCURRENCY=4
CORRELATE_CONCURRENCY=8
# Demo posts (source_type 'demo') past the retention window are deleted with
# their score/audit rows in batches of this many posts (1-5000). Default: 500
DEMO_PURGE_BATCH_SIZE=500

# ─── Audit Trail ──────────────────────────────────────────────────────────────
# Server-held key for the input_hash exposed by GET /api/audit/:post_id.
# The stored hash is an unsalted SHA-256 of post content, which is offline-
# confirmable for guessable text — so the API exposes HMAC-SHA256(key, hash)
# instead. If unset, input_hash is omitted from responses entirely.
# Generate with: openssl rand -hex 32
AUDIT_HASH_KEY=replace_with_random_64_hex_chars
# Offline gold-set tools (npm run gold:*): key for the post-text fingerprint
# (HMAC-SHA256, at least 32 characters, never a template value). Empty: AUDIT_HASH_KEY is used. Never change it
# once a gold sample exists. GOLD_ALLOW_DB_PORT acknowledges a local throwaway
# database on a port other than 5433/5434.
GOLD_HASH_KEY=
GOLD_ALLOW_DB_PORT=

# Provenance fingerprint key (decision D2, ingest@1.3.0). Every collected post
# stores HMAC-SHA256(key, source_slug:upstream id:source URL) so its origin
# can be proven later with `npm run verify-provenance -- --post <id> --url
# <original>`. Empty: AUDIT_HASH_KEY is used. Never change it once posts are
# collected (old fingerprints would no longer verify).
PROVENANCE_KEY=

# ─── Cross-Platform Correlation ───────────────────────────────────────────────
# Deployment-specific salt: the HMAC-SHA256 key of the correlation signal hash (src/pipeline/correlation.js computeSignalHash; pseudonymous IDs are adjective-animal, e.g. 'balanced-impala'). Generate once, never change.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Compose passes it to the worker ONLY; web gets the presence flag
# CORRELATION_SALT_SET (PR #22 security L1).
CORRELATION_SALT=replace_with_random_64_hex_chars

# Cross-platform correlation is OFF until a DPIA is completed (spec §20, GDPR Art. 35),
# and it is NOT IMPLEMENTED: with no author stored there is no identity signal, so even
# with the DPIA reference, the switch and the salt set it stays off ("not implemented:
# signal design pending DPIA", PR #22 grumpy M7). /api/health shows the status.
CORRELATION_DPIA_REF=
CORRELATION_ENABLED=false

# ─── Docker Compose ───────────────────────────────────────────────────────────
# Stable project name: containers/volumes stay owned by one compose project
# regardless of which worktree runs docker compose (matches name: in docker-compose.yml)
COMPOSE_PROJECT_NAME=pulse-of-ai

# ─── One-command standup (npm run standup → compose profile "full") ──────────
# Standup settings read from the shell that runs npm run standup, never from
# this file: PULSE_ENV_FILE (the env file to use, default .env), STANDUP_TIMEOUT
# (core services, default 300 s) and STANDUP_EMBEDDINGS_TIMEOUT (first model
# download, default 900 s), e.g.
#   STANDUP_TIMEOUT=600 npm run standup
# Host ports published by the full stack. POSTGRES_PORT / POSTGRES_TEST_PORT
# above and REDIS_PORT here are also host ports; inside the compose network
# the containers always use postgres:5432, redis:6379 and embeddings:8000.
# The embeddings service is never published (its API is unauthenticated).
# Change any of them to run a second stack beside this one.
# The queue store is Valkey (BSD-3-Clause), which speaks the Redis protocol.
# The REDIS_* variable names are kept on purpose: BullMQ, ioredis and every
# existing env file use them, and they name the protocol, not the product.
# REDIS_HOST: the queue store's host for processes run on the host (npm run dev,
# the host worker, CLI scripts); unset = 127.0.0.1. Compose always sets it to
# `redis` inside the network, whatever this file says.
# REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional Redis-protocol logical database for the queues (isolates a second stack or a
# local run on a shared Valkey/Redis). Empty = database 0.
REDIS_DB=
WEB_PORT=3000
# Interface EVERY published port binds to: web, postgres, postgres_test and
# redis. 127.0.0.1 keeps them off the network; 0.0.0.0 exposes all of them
# (databases included) — use it only if other machines must reach the stack.
PULSE_BIND_ADDR=127.0.0.1

# Queue-store password (compose runs valkey-server with requirepass; BullMQ, the
# worker and /api/health authenticate with it). npm run standup generates it.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=replace_with_random_64_hex_chars

# Demo population feed (compose service `populate`, profile "demo").
# The standup collects REAL data first (npm run collect via scripts/populate.js)
# and feeds FICTIONAL demo posts through the real pipeline only when collection
# yields nothing in the trailing hour (see scripts/populate.js).
DEMO_FEED_INTERVAL_MS=150000
# Posts per demo batch; empty = two per source category (16)
DEMO_FEED_BATCH=

# ─── Alerting: the external watchdog (compose service `watchdog`, profile "full") ──
# The watchdog runs in its OWN container, so it still alerts when the worker
# is dead. Every WATCHDOG_POLL_INTERVAL_S it polls web's /api/health and
# probes the database; on worker down, retention overdue, maintenance
# failing, collection failing, an abnormal queue or failed-job count, or the
# DB / Valkey / web API unreachable it opens ONE critical alert per condition
# (red "SYSTEM ALERT" on the dashboard health chip and banner) and e-mails
# SMTP_TO once when the condition opens and once when it clears.
# All optional; empty = the default in brackets. Invalid values fall back to
# the default and are listed in the health drawer (never a crash).
#   WATCHDOG_POLL_INTERVAL_S (120, 15..3600)   WATCHDOG_INITIAL_DELAY_S (60)
#   WATCHDOG_MAX_QUEUE_DEPTH (5000 waiting+delayed in one queue)
#   WATCHDOG_MAX_QUEUE_FAILED_PER_HOUR (25)    WATCHDOG_MAX_FAILED_CYCLES_PER_HOUR (3)
#   WATCHDOG_RETENTION_MAX_AGE_MIN (30)        WATCHDOG_DAILY_MAX_AGE_H (26)
#   WATCHDOG_TERMS_MAX_AGE_H (192)             WATCHDOG_EMAIL_MAX_PER_HOUR (12)
#   WATCHDOG_DASHBOARD_URL — link put in the e-mails, e.g. http://localhost:3000
WATCHDOG_POLL_INTERVAL_S=
WATCHDOG_DASHBOARD_URL=
# E-mail (SMTP). Leave SMTP_HOST empty for dashboard-only alerting; /api/health
# then reports "email alerting not configured". E-mail is on when SMTP_HOST,
# SMTP_FROM and SMTP_TO are all set.
#   SMTP_SECURE=true  → TLS from the first byte (port 465 by default)
#   SMTP_SECURE=false → STARTTLS (port 587 by default), REQUIRED unless
#                       SMTP_REQUIRE_TLS=false (only for a relay on your own host)
#   SMTP_TO: comma-separated recipients.
# SMTP_PASSWORD reaches the watchdog container ONLY: web never gets it and the
# worker's copy of this file has it blanked (scripts/test/check-compose.sh).
# Put it here, never on a command line (shell history).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ════════════════════════════════════════════════════════════════════════════
# SOURCE COLLECTION — the 52-source registry of record (src/config/source-registry.js)
# Generated from the registry env catalogue; tests/unit/pure/sourceEnv.test.js
# fails if a variable the collectors read is missing here or in docker-compose.yml.
# Secrets go in .env only — never in code or in this file.
# ════════════════════════════════════════════════════════════════════════════

# ─── Collector identity and cadence (ADR 0001) ─────────────────────────────────
# Every request carries "PulseOfAI/<version> (+COLLECTOR_CONTACT_URL; non-commercial AI discourse research)".
# OFF BY DEFAULT (ADR 0001, decision D1 "Off for others, on for you"): a fresh
# clone ships this EMPTY, so every source is DISABLED and `npm run standup`
# populates DEMO data only. Set it to a page where publishers can reach YOU
# (your repository or a contact page), never someone else's — the requests go
# out under your identity. standup asks for it when run interactively.
# Contact URL placed in the collector User-Agent (required: collection is disabled without it)
#   get it: https://foundation.wikimedia.org/wiki/Policy:Wikimedia_Foundation_User-Agent_Policy
COLLECTOR_CONTACT_URL=
# The 8 permission-gated news feeds of ADR 0001 ruling 4 (BBC, NYT, Guardian,
# Al Jazeera, WSJ, NBC, Washington Post, Ars Technica) publish public RSS, but
# their terms require permission for automated analysis. They stay CLOSED
# until you record here that YOU accept that legal risk, as "<name> <YYYY-MM-DD>".
# Leave it empty unless you have made that decision yourself.
# Operator acknowledgement ("<name> <YYYY-MM-DD>") that opens the 8 permission-gated news feeds of ADR 0001 ruling 4 (BBC, NYT, Guardian, Al Jazeera, WSJ, NBC, Washington Post, Ars Technica): their terms require permission for automated analysis, and setting this records that you accept that legal risk. Empty keeps them closed
PERMISSION_GATED_FEEDS_ACCEPTED_BY=
# PR #22 decision G5 (Jennifer, 2026-09-29): a key, an approval reference, a
# licence or the acknowledgement above is not enough on its own — opening
# any gated source also needs a NAMED approval, "<name> <YYYY-MM-DD>", of
# the person who approved opening it. npm run source:disable / enable / reset
# refuse to run without it, and record it as the actor.
# Named approval ("<name> <YYYY-MM-DD>") required to open ANY gated source — one that needs a key, an approval, a licence or a permission (PR #22 decision G5). Without a valid value those sources stay closed ("awaiting named approval"); keyless sources are unaffected. It is recorded as the approver of every gate opening and of every database kill-switch change (source_gate_events). Empty keeps gated sources closed
GATE_APPROVED_BY=
# Collection cycle length in ms (default 150000)
COLLECT_WINDOW_MS=150000

# ─── POST /api/refresh (F10-8) ────────────────────────────────────────────────
# Refresh enqueues one collection to the worker (409 while one is running).
# Shared secret the caller sends as X-Refresh-Token; once set, every refresh
# must send it. REQUIRED when the site is bound beyond loopback (PULSE_BIND_ADDR
# / HOST not a loopback address) or reached through a reverse proxy (a Forwarded,
# X-Forwarded-For, X-Forwarded-Host or X-Real-IP header): without it refresh is
# refused (403) there. Generate with: openssl rand -hex 32
REFRESH_TOKEN=
# A refresh job still 'running' that has made no progress for this many minutes (a worker crash) is marked failed.
REFRESH_STALE_MINUTES=30

# ─── Kill switches — turn any feed off without a code change ───────────────────
# Per source: SOURCE_<SLUG>_ENABLED=false (slugs: src/config/source-registry.js), e.g.
#   SOURCE_BBC_NEWS_ENABLED=false
# or list slugs in COLLECTORS_DISABLED. Container env is fixed when a container
# is CREATED: after editing .env run `docker compose up -d worker web` (a
# recreate — `docker restart` does NOT pick up .env changes). For an
# immediate takedown without touching env, use the database kill switch:
#   npm run source:disable -- <slug> --reason "<why>"   (undo: npm run source:enable -- <slug>)
# It applies before the next run in every process (F10-10).
# Global kill switch: false stops every collector
COLLECTORS_ENABLED=true
# Comma-separated source slugs to turn off (per-source kill switch)
COLLECTORS_DISABLED=
# Per ROUTE (migration 073): turn off one route of a source while its other
# routes keep collecting, as "slug/route" (route ids: src/config/source-registry.js),
# e.g. COLLECTORS_DISABLED_ROUTES=hugging_face/forum-latest
# Like COLLECTORS_DISABLED it applies on a container RECREATE. The immediate,
# recorded equivalent (no env change, applies before the next run in every process):
#   npm run source:disable -- <slug> --route <route_id> --reason "<why>"
#   (undo: npm run source:enable -- <slug> --route <route_id>)
# Comma-separated slug/route ids to turn off (per-route kill switch), e.g. hugging_face/forum-latest; the source's other routes keep collecting. Fails closed: an entry whose route is not a route of the source it names holds that whole source disabled, and an entry naming no registry source holds EVERY source disabled (Reddit's deletion re-checks pause too; its local 48 h text removal does not), until it is fixed
COLLECTORS_DISABLED_ROUTES=
# Refused sources (F10-5): a source that answered 401/403/451, a bot wall or a
# robots.txt disallow is not asked again through a cooldown of 1 h doubling up
# to 24 h; a clean probe after it resumes collection under a 24 h probation that
# keeps the refusal count (migration 062). Clear both at once with
# SOURCE_<SLUG>_RESET=<date> together with a valid GATE_APPROVED_BY (without it
# the reset is ignored), where <date> is at or after the last refusal and NOT in
# the future, e.g.
#   SOURCE_CATO_RESET=2026-10-01T09:30:00+10:00
# A date-only value (2026-10-01) means 00:00 UTC of that day, not local time;
# a date-time needs Z or an offset. A future date is ignored until it passes.
# Or without an env change: npm run source:reset -- <slug> --note "<why>"

# ─── Free self-service keys — the source shows "awaiting key" until set ────────
# YouTube Data API v3 key — YouTube (Alphabet)
#   get it: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# Springer Nature Meta API key — SpringerLink (Springer Nature)
#   get it: https://dev.springernature.com
SPRINGER_API_KEY=
# IMAP host of the dedicated Scholar-alert mailbox — Google Scholar
#   get it: https://scholar.google.com/intl/en/scholar/help.html
SCHOLAR_ALERTS_IMAP_HOST=
# Mailbox user — Google Scholar
#   get it: https://scholar.google.com/intl/en/scholar/help.html
SCHOLAR_ALERTS_IMAP_USER=
# Mailbox app password (secret) — Google Scholar
#   get it: https://scholar.google.com/intl/en/scholar/help.html
SCHOLAR_ALERTS_IMAP_PASSWORD=
# IMAP port (default 993, TLS) — Google Scholar
SCHOLAR_ALERTS_IMAP_PORT=993
# Mailbox folder holding the alerts (default INBOX) — Google Scholar
SCHOLAR_ALERTS_MAILBOX=INBOX
# api.data.gov key for the GovInfo search API (the collection RSS needs none) — GovInfo (US GPO)
#   get it: https://api.data.gov/signup/
GOVINFO_API_KEY=
# Congress.gov API key — Congress.gov (Library of Congress)
#   get it: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# ─── Optional free tokens — raise rate limits of sources that already collect keyless ───
# NCBI key (3 → 10 requests/s) — PubMed / PMC (NCBI)
#   get it: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# E-utilities tool name (default pulse-of-ai) — PubMed / PMC (NCBI)
#   get it: https://support.nlm.nih.gov/kbArticle/?pn=KA-05317
NCBI_TOOL=pulse-of-ai
# E-utilities contact email — PubMed / PMC (NCBI)
#   get it: https://support.nlm.nih.gov/kbArticle/?pn=KA-05317
NCBI_EMAIL=
# Fine-grained token, no scopes (raises the search limit) — GitHub
#   get it: https://github.com/settings/tokens
GITHUB_TOKEN=
# read_api token (raises the limit to 5,000/hour) — GitLab
#   get it: https://gitlab.com/-/user_settings/personal_access_tokens
GITLAB_TOKEN=
# Hugging Face read token — Hugging Face
#   get it: https://huggingface.co/settings/tokens
HF_TOKEN=
# Stack Exchange app key (quota 300 → 10,000/day) — Stack Overflow
#   get it: https://stackapps.com/apps/oauth/register
STACKEXCHANGE_KEY=

# ─── Researcher / publisher approval — "awaiting approval" until set ───────────
# Meta Content Library approval reference (WhatsApp, Instagram, Facebook) — WhatsApp (Meta), Instagram (Meta), Facebook (Meta)
#   get it: https://transparency.meta.com/researchtools/meta-content-library
META_CONTENT_LIBRARY_APPROVAL_REF=
# Directory holding approved MCL exports (JSON lines per product) — WhatsApp (Meta), Instagram (Meta), Facebook (Meta)
#   get it: https://transparency.meta.com/researchtools/meta-content-library
META_CONTENT_LIBRARY_EXPORT_DIR=
# TikTok Research API client key — TikTok (ByteDance)
#   get it: https://developers.tiktok.com/products/research-api/
TIKTOK_RESEARCH_CLIENT_KEY=
# TikTok Research API client secret — TikTok (ByteDance)
#   get it: https://developers.tiktok.com/products/research-api/
TIKTOK_RESEARCH_CLIENT_SECRET=
# Elsevier API key — ScienceDirect (Elsevier)
#   get it: https://dev.elsevier.com
ELSEVIER_API_KEY=
# Elsevier use-case approval reference — ScienceDirect (Elsevier)
#   get it: https://dev.elsevier.com/policy.html
ELSEVIER_APPROVAL_REF=

# Reddit (#52, Forums) — "awaiting approval" until ALL FOUR are set (ADR 0001
# rulings 8 and 9). Reddit's Responsible Builder Policy requires explicit
# approval before ANY Data API access; self-service keys are closed.
#   1. Read the Developer Terms, the Data API Terms and the Responsible Builder
#      Policy, and publish a privacy policy for the dashboard (a prerequisite).
#   2. File the request — non-commercial, "developer" (NOT researcher, NOT
#      enterprise) — with the draft in docs/requests/2026-09-29-reddit-data-api-request.md:
#      https://support.reddithelp.com/hc/en-us/requests/new?ticket_form_id=14868593862164
#   3. Once approved, register the app at https://developers.reddit.com/app-registration
#      to get the client id and secret, and record Reddit's approval reference.
# Collection never scrapes reddit.com: the OAuth Data API only. Post text is
# removed 48 h after collection or when deleted upstream (a 6-hourly
# re-check); scores and audit rows are kept (ruling 9). Off switch:
# SOURCE_REDDIT_ENABLED=false.
# Reddit Data API OAuth client id of the APPROVED app (register it at https://developers.reddit.com/app-registration once Reddit approves the request)
#   get it: https://support.reddithelp.com/hc/en-us/requests/new?ticket_form_id=14868593862164
REDDIT_CLIENT_ID=
# Reddit OAuth client secret (secret; never logged or stored)
#   get it: https://developers.reddit.com/app-registration
REDDIT_CLIENT_SECRET=
# Reddit's required User-Agent, "<platform>:<app id>:<version> (by /u/<reddit username>)", e.g. server:pulse-of-ai:v1.0.0 (by /u/yourname); unique and truthful
#   get it: https://support.reddithelp.com/hc/en-us/articles/16160319875092-Reddit-Data-API-Wiki
REDDIT_USER_AGENT=
# Reddit's approval reference for the Data API request (the ticket or approval id)
#   get it: https://support.reddithelp.com/hc/en-us/articles/42728983564564-Responsible-Builder-Policy
REDDIT_API_APPROVAL_REF=
# Subreddit selection: minimum AI-mentioning posts in the rolling 7 days for a subreddit to qualify (default 20)
REDDIT_MIN_AI_POSTS_7D=20
# Path of the JSTOR Text Analysis Support dataset (JSON lines) — JSTOR (ITHAKA)
#   get it: https://www.jstor.org/ta-support
JSTOR_DATASET_PATH=

# ─── Paid APIs and paid tiers — "awaiting licence" until set (a paid tier replaces the free feed) ───
# X API v2 bearer token (pay-per-use; replaces TWITTER_BEARER_TOKEN) — X (formerly Twitter)
#   get it: https://developer.x.com
X_BEARER_TOKEN=
# NYT developer key (paid tier; used only with NYT_LICENSE_REF) — The New York Times
#   get it: https://developer.nytimes.com
NYT_API_KEY=
# NYT Licensing TDM licence reference — The New York Times
#   get it: https://nytlicensing.com/data-solutions/
NYT_LICENSE_REF=
# CNN Wire Store licence reference — CNN
#   get it: https://www.cnn.com/intlsyndication/
CNN_LICENSE_REF=
# Contract delivery feed URL — CNN
#   get it: https://www.cnn.com/intlsyndication/
CNN_FEED_URL=
# Delivery credential, when the contract uses one — CNN
#   get it: https://www.cnn.com/intlsyndication/
CNN_API_KEY=
# Guardian COMMERCIAL Content API key (paid tier; used only with GUARDIAN_COMMERCIAL_LICENSE_REF) — The Guardian
#   get it: https://bonobo.capi.gutools.co.uk/register/commercial
GUARDIAN_API_KEY=
# Guardian commercial licence reference (the key alone is not the permission the Open Platform terms require) — The Guardian
#   get it: https://bonobo.capi.gutools.co.uk/register/commercial
GUARDIAN_COMMERCIAL_LICENSE_REF=
# Dow Jones feed credential (paid tier) — The Wall Street Journal
#   get it: https://www.dowjones.com/
DOWJONES_API_KEY=
# Dow Jones contract feed URL — The Wall Street Journal
#   get it: https://www.dowjones.com/
DOWJONES_FEED_URL=
# AP Media API key — Associated Press
#   get it: https://developer.ap.org
AP_API_KEY=
# Reuters Connect OAuth client id — Reuters
#   get it: https://www.reutersagency.com
REUTERS_CONNECT_CLIENT_ID=
# Reuters Connect OAuth client secret — Reuters
#   get it: https://www.reutersagency.com
REUTERS_CONNECT_CLIENT_SECRET=
# IEEE Xplore API key — IEEE Xplore
#   get it: https://developer.ieee.org
IEEE_API_KEY=
# IEEE alternative-licensing reference — IEEE Xplore
#   get it: https://developer.ieee.org/contact
IEEE_LICENSE_REF=
# OAuth token endpoint from the contract (default provided)
#   get it: https://www.reutersagency.com
REUTERS_CONNECT_TOKEN_URL=
# GraphQL endpoint from the contract (default provided)
#   get it: https://www.reutersagency.com
REUTERS_CONNECT_API_URL=

# ─── Publisher permission references — record once granted ─────────────────────
# The BBC, NBC, Washington Post, Al Jazeera and Ars Technica feeds run only while
# PERMISSION_GATED_FEEDS_ACCEPTED_BY is set (see above); set the reference when the
# publisher grants permission.
# CFR is held until CFR confirms /feed may be read (robots.txt "Disallow: /feed/", read conservatively).
# BBC permission reference, recorded once granted (the feed runs now per ADR 0001) — BBC News
#   get it: https://www.bbc.co.uk/usingthebbc/terms-of-use
BBC_LICENSE_REF=
# Al Jazeera Content Sales reference, recorded once granted — Al Jazeera
#   get it: https://contentsales.aljazeera.net/
ALJAZEERA_LICENSE_REF=
# NBCUniversal permission reference, recorded once granted — NBC News
#   get it: https://www.nbcnews.com/id/wbna5216556
NBC_LICENSE_REF=
# WP Licensing & Syndication reference, recorded once granted — The Washington Post
#   get it: https://www.washingtonpost.com/licensing-syndication/
WAPO_LICENSE_REF=
# CFR confirmation that /feed may be read despite "Disallow: /feed/" — Council on Foreign Relations
#   get it: https://www.cfr.org/
CFR_FEED_PERMISSION_REF=
# Condé Nast permission reference, recorded once granted — Ars Technica
#   get it: https://www.condenast.com/user-agreement
ARSTECHNICA_LICENSE_REF=

# ─── BLOCKED sources — run ONLY with an explicit official permission (never set these otherwise) ───
# WeChat, Telegram, ResearchGate and Cato show "blocked: no compliant access" until their official
# permission exists. Bot walls, CAPTCHAs and 403s are never worked around.
# Tencent written authorization reference — WeChat / Weixin (Tencent)
#   get it: https://weixin.qq.com/agreement?lang=en_US
WECHAT_TENCENT_AUTHORIZATION_REF=
# Feed URL Tencent authorizes — WeChat / Weixin (Tencent)
#   get it: https://weixin.qq.com/agreement?lang=en_US
WECHAT_AUTHORIZED_FEED_URL=
# Exact host named in Tencent's written authorization; the feed URL must be on this host (G10-17) — WeChat (Weixin)
#   get it: https://weixin.qq.com/agreement?lang=en_US
WECHAT_AUTHORIZED_FEED_HOST=
# Telegram written permission reference (API Terms §1.5) — Telegram
#   get it: https://core.telegram.org/api/terms
TELEGRAM_WRITTEN_PERMISSION_REF=
# Bot API token (used only with the permission reference) — Telegram
#   get it: https://core.telegram.org/bots#how-do-i-create-a-bot
TELEGRAM_BOT_TOKEN=
# ResearchGate data-access grant reference — ResearchGate
#   get it: https://www.researchgate.net/terms-of-service
RESEARCHGATE_DATA_ACCESS_REF=
# Path of the dataset ResearchGate delivers (JSON lines) — ResearchGate
#   get it: https://www.researchgate.net/terms-of-service
RESEARCHGATE_DATASET_PATH=
# Reference of Cato allowlisting the collector User-Agent — Cato Institute
#   get it: https://www.cato.org/
CATO_ALLOWLIST_REF=
