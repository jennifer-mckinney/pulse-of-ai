# Environment — never commit secrets
.env
.env.local
.env.*.local

# Node
node_modules/
npm-debug.log*

# Test coverage output
coverage/

# Python
__pycache__/
*.py[cod]
*.pyo
python/.venv/
python/venv/
*.egg-info/

# Database files (legacy SQLite — replaced by PostgreSQL)
data/*.db
data/*.sqlite
data/latest_posts.json

# OS
.DS_Store
Thumbs.db
*.textClipping

# macOS artifact directories and vendor bundles (not source-controlled)
exported-assets/
exported-assets.textClipping
scrollama-main/
/js/

# Editor
.vscode/
.idea/
*.swp
*.swo

# Backup / scratch files — never commit
*.bak
*.backup
*.corrupted
*.save
*.save2

# Claude Code local config — contains machine-specific absolute paths
.claude/

# Development logs and scratch files
firebase-debug.log
firebase-debug.*.log
endpoint_to_add.txt
claude-netlog-*.json

# Shell script iterations (committed versions only; working copies ignored)
update_mapbox*.sh
"update_mapbox copy.sh"
