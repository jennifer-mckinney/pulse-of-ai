flowchart TD

  subgraph SOURCES["① DATA SOURCES  ·  50 seeded sources across 7 categories"]
    direction LR
    S1["Reddit<br/>Pushshift"]
    S2["arXiv<br/>API"]
    S3["RSS Feeds<br/>News / Policy"]
    S4["Playwright<br/>Scraper  P2"]
    S5["Twitter/X<br/>Bearer · seeded inactive"]
  end

  subgraph INGEST["② INGEST  ·  BullMQ queues · collect processors planned"]
    direction LR
    I1["collect.reddit<br/>queue"]
    I2["collect.arxiv<br/>queue"]
    I3["collect.rss<br/>queue"]
    I4["collect.scraper<br/>queue"]
    SCH["workers/collector.scheduler.js<br/>per-source stagger · stale cleanup<br/>start.js wiring planned"]
    INX["pipeline/<br/>ingest.js<br/>PII strip · dedup<br/>SHA-256 hash"]
  end

  subgraph DB["③ POSTGRESQL 16 + pgvector  ·  6 migrations"]
    direction TB
    DB1[("raw_posts<br/>external_id · content_hash<br/>raw_payload JSONB")]
    DB2[("sentiment_results<br/>relevance_results<br/>discourse_scores")]
    DB3[("decision_audit_log<br/>methodology_versions")]
    DB4[("post_embeddings<br/>VECTOR 384")]
    DB5[("bias_assessments<br/>alert_events")]
    DB6[("pseudonymous_users<br/>user_platform_sightings")]
  end

  subgraph PIPELINE["④ PROCESSING PIPELINE  ·  TDD · audit log every step"]
    direction LR
    P1["sentiment.js<br/>AFINN · v1.0.0"]
    P2["relevance.js<br/>keyword hybrid"]
    P3["discourse.js<br/>DQI scoring"]
    P4["embeddings.js<br/>all-MiniLM-L6-v2<br/>384-dim"]
    P5["correlation.js<br/>verb-noun ID<br/>≥0.85 conf"]
  end

  subgraph PYTHON["⑤ PYTHON SERVICE  ·  FastAPI + sentence-transformers"]
    PY["embeddings_service.py<br/>sentence-transformers embed<br/>port 8000"]
  end

  subgraph API["⑥ EXPRESS API  ·  port 3000"]
    direction LR
    A1["GET /api/posts<br/>/aggregated-by-location"]:::done
    A2["GET /api/sentiment<br/>/latest"]:::done
    A3["GET /api/audit/:post_id<br/>HMAC-keyed input fingerprint<br/>AUDIT_HASH_KEY env"]:::done
    A4["GET /api/health<br/>bias alerts"]:::done
    A5["GET /api/config<br/>Mapbox token"]:::done
    A6["GET /api/themes<br/>keyword themes"]:::done
    A7["GET /api/sources<br/>/timeseries · hourly by category"]:::done
    A8["POST /api/query<br/>+ location filter"]:::done
  end

  subgraph FRONTEND["⑦ FRONTEND  ·  globe.gl WebGL globe + scrollama story · vendored, no CDN (FR-25)"]
    direction LR
    FC["js/config/<br/>story · design · api<br/>.config.js · data-only"]:::done
    FM["utils.js · data.js<br/>insights.js · chapters.js<br/>pure · jest-tested"]:::done
    FV["vendor/<br/>fonts · land-110m GeoJSON<br/>globe.gl · scrollama"]:::done
    FSH["page shell<br/>C1"]:::wip
    FB["globe.js C2 · story.js C3<br/>ui.js C4 · browser layer"]:::planned
    F1["map.js<br/>legacy Mapbox globe<br/>removal C5"]:::planned
    F2["main.js<br/>health status<br/>refresh"]:::done
  end

  subgraph LEGEND["STATUS  ·  plan tracking"]
    direction LR
    LD["delivered"]:::done
    LW["in progress"]:::wip
    LP["planned"]:::planned
    LN["also planned: city registry config · Playwright E2E<br/>coverage TARGET 98 pct — issue 3 · jest gate today 80/80/70<br/>Phase D doc consolidation"]:::planned
  end

