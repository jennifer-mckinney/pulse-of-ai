    B3["utils · data · insights · chapters<br/>pure, jest-tested"]:::done
    B4["globe.js PulseGlobe<br/>Canvas-2D dot globe"]:::done
    B5["story.js PulseStory<br/>11-beat scroll story"]:::done
    B6["ui.js PulseUI<br/>explore, ribbon, audit + health drawers"]:::done
    B7["main.js PulseMain<br/>shell, health chip, about panel"]:::done
  end

  subgraph WEB["③ web · src/server.js · :3000"]
    direction TB
    W0["security headers on every response<br/>CSP script-src 'self', style-src 'self'<br/>+ express.static public/"]:::done
    W1["refresh router, no CORS<br/>POST /api/refresh<br/>same-origin guard → 202 / 409 / 429"]:::done
    W2["read-only router, cors()<br/>GET /api/health · /api/posts/aggregated-by-location<br/>GET /api/sentiment/latest · /api/audit/:post_id<br/>GET /api/bias/latest · /api/bias/history<br/>GET /api/methodology · /api/sources<br/>GET /api/sources/timeseries · /api/themes<br/>POST /api/query"]:::done
    W3["/api/health staleness alerts"]:::wip
  end

  subgraph REDIS["④ redis · BullMQ"]
    direction TB
    Q0["redis:7-alpine<br/>requirepass, AOF"]:::done
    Q1["collect.rss · collect.api · collect.bulk<br/>one job scheduler per collecting source"]:::done
    Q2["collect.refresh"]:::done
    Q3["ingest · embed · correlate"]:::done
    Q4["pulse:worker:heartbeat<br/>TTL 90 s"]:::done
  end

  subgraph WORKER["⑤ worker · src/workers/start.js"]
    direction TB
    K0["the only role holding<br/>collector credentials"]:::done
    K1["collector.scheduler<br/>reschedules every 10 min"]:::done
    K2["collect.worker → collectors/runner<br/>gates, fetch, store, score inline"]:::done
    K3["cycle closer every 30 s<br/>bias checks per cycle + unscored sweep"]:::done
    K4["ingest.worker scoring retries<br/>embed.worker · correlate.worker reserved"]:::done
    K5["Reddit maintenance every 5 min<br/>48 h text blanking, re-check, discovery"]:::done
    K6["heartbeat every 15 s"]:::done
    K7["collect enqueues ingest (new topology)<br/>scheduled compaction, per-source retention"]:::wip
  end

  subgraph EXT["① External sources · 52-source registry"]
    direction TB
    XH["src/config/source-registry.js, spec §17<br/>gate status with COLLECTOR_CONTACT_URL and<br/>PERMISSION_GATED_FEEDS_ACCEPTED_BY both set"]:::done
    X1["collecting · 31<br/>23 keyless or keyless tier<br/>+ 8 permission-gated news RSS"]:::done
    X2["awaiting_key · 4<br/>YouTube, SpringerLink,<br/>Google Scholar, Congress.gov"]:::done
    X3["awaiting_approval · 8<br/>WhatsApp, Instagram, Facebook, TikTok,<br/>ScienceDirect, JSTOR, CFR, Reddit"]:::done
    X4["awaiting_licence · 5<br/>X, CNN, AP, Reuters, IEEE Xplore"]:::done
    X5["blocked · 4<br/>WeChat, Telegram, ResearchGate, Cato"]:::done
    X0["fresh clone, no contact URL:<br/>48 disabled + 4 blocked,<br/>demo data only (ADR 0001 D1)"]:::done
  end

  subgraph EMB["⑥ embeddings · FastAPI"]
    E1["embeddings:8000, not published<br/>POST /embeddings · GET /health<br/>all-MiniLM-L6-v2 at a pinned revision<br/>384-dim, hf_cache volume"]:::done
