%% Title: Trust boundaries and security controls
%% Summary: The three trust boundaries (browser to web, worker to the internet, containers to the host) and the control that guards each crossing: CSP, CORS scope, the refresh CSRF guard, the SSRF guard, secret scrubbing and PII redaction.
%% Sources: src/server.js, src/middleware/same-origin.js, src/routes/{refresh,audit,sources}.js, src/collectors/{http,netguard,transport,robots,redact,errors,identity,normalize,provenance}.js, src/pipeline/ingest.js, docker-compose.yml, public/js/*.js (DOM discipline). Spec: TECHNICAL_SPEC.md section 8 (security and privacy).
flowchart LR

  subgraph INTERNET["Untrusted · readers' browsers and any caller"]
    direction TB
    U1["browser tab on this origin"]:::done
    U2["cross-site page or script"]:::done
  end

  subgraph WEBB["Boundary 1 · web (public surface)"]
    direction TB
    C1["every response: CSP default-src 'self', script-src 'self',<br/>style-src 'self', object-src 'none', frame-ancestors 'none';<br/>X-Content-Type-Options nosniff, X-Frame-Options DENY,<br/>Referrer-Policy no-referrer"]:::done
    C2["CORS only on the read-only router;<br/>POST /api/refresh mounted first, without CORS,<br/>OPTIONS answered 403"]:::done
    C3["refresh CSRF guard: Sec-Fetch-Site same-origin or none,<br/>else Origin / Referer host = Host, else 403;<br/>X-Refresh-Token required beyond loopback;<br/>409 in flight, 60 s global debounce"]:::done
    C4["input validation: UUID post ids, integer hours,<br/>canonical categories, dates, limit ≤ 100;<br/>500s return a generic message only"]:::done
    C5["audit input_hash served as HMAC(AUDIT_HASH_KEY),<br/>omitted without a key; /api/sources serves error_kind<br/>and http_status, never error text or env values"]:::done
    C6["frontend: textContent only, no innerHTML;<br/>all assets self-hosted, no CDN"]:::done
  end

  subgraph WORKB["Boundary 2 · worker to the internet"]
    direction TB
    S1["SSRF guard on every hop: https only, public hosts,<br/>route allowedHosts, DNS answers checked and pinned,<br/>redirects checked hop by hop (max 4)"]:::done
    S2["credentials never cross origins: a credentialed<br/>request is refused a cross-origin redirect"]:::done
    S3["response caps (5 MB, robots 500 KiB, bulk 50 MB),<br/>decompression counted, DTD entities refused,<br/>linear-time text processing"]:::done
    S4["politeness: contact User-Agent, robots.txt,<br/>per-host spacing; 401/403/451/challenge never retried,<br/>source enters the refused state"]:::done
    S5["secret scrubbing: every stored or logged error passes<br/>redactUrl + scrub (env secrets raw and URL-encoded)"]:::done
    S6["PII: allowlisted payload, PII_FIELDS removed,<br/>in-text redaction (ingest@1.5.0), city-level location,<br/>identity-bearing ids stored as keyed fingerprints"]:::done
  end

  subgraph HOSTB["Boundary 3 · containers to the host and network"]
    direction TB
    D1["published ports bind 127.0.0.1 by default<br/>(PULSE_BIND_ADDR); embeddings never published"]:::done
    D2["secrets split: collector credentials reach the worker only;<br/>web gets presence markers (set / empty)"]:::done
    D3["redis requirepass (config file, not argv);<br/>.env mode 600, generated secrets never printed"]:::done
    D4["app and embeddings images run as non-root users;<br/>base images pinned by digest"]:::done
  end

  EXT["registry sources on the internet"]:::done
  WK["worker process"]:::done
  DB[("PostgreSQL · Redis")]:::done

  subgraph LEGEND["Status legend"]
    L1["done: on master"]:::done
  end

  U1 -- "GET / and /api/*" --> C1
  U2 -. "simple cross-site POST" .-> C3
  C1 --> C2 --> C3
  C2 --> C4 --> C5
  C1 --> C6
  WK --> S1 --> S2 --> S3 --> EXT
  S4 --> EXT
  EXT -- "responses" --> S6 --> DB
  WK --> S5 --> DB
  D2 --> WK
  D1 --> DB

