%% Title: Data model 1 of 4 · sources, collection state, jobs, alerts, Reddit
%% Summary: The tables that describe the 52 registry sources, their collection state and runs, the processing jobs every score belongs to, alerts, and Reddit's selection, budget and maintenance state.
%% Sources: src/db/migrations/001, 003, 013, 016, 018, 019, 020, 021, 023, 025, 033, 037, 038, 040, 050, 062. Alert writers: src/pipeline/bias.js (writeAlertEvent), src/collectors/source-alerts.js, source-health.js, retention-overdue.js, state.js, governance.js, src/watchdog/store.js and conditions.js. raw_posts is shown with its keys only (full columns in data model 2); alert resolutions, run rollups, gate events and the watchdog tables are in data model 4. Dotted lines are logical links without a foreign key. NOTE_alert_type_values is a legend box, not a table. Spec: TECHNICAL_SPEC.md section 6.
erDiagram

  data_sources {
    uuid id PK
    text name UK "slug, e.g. bbc_news; demo_{category} for the demo feeds"
    text display_name
    text source_type "rss | api | bulk | demo; retired rows keep older values"
    text category "8-category canon"
    jsonb config
    boolean active
    timestamptz created_at
    timestamptz retired_at "013: pre-registry rows retired"
    text retired_note
    timestamptz collection_disabled_at "020: database kill switch"
    text collection_disabled_reason
    text collection_disabled_by
  }

  source_collection_state {
    uuid source_id PK, FK
    jsonb cursor "per-route since ids"
    jsonb http_cache "ETag / Last-Modified; Retry-After hold per host"
    timestamptz last_attempt_at
    timestamptz last_success_at
    int last_item_count
    int last_new_posts
    text last_error "scrubbed"
    timestamptz last_error_at
    int consecutive_failures
    text last_error_kind "016"
    int last_http_status "016"
    timestamptz access_denied_at "018: refused state"
    int access_denied_status
    text access_denied_kind
    timestamptz refused_until
    int refusal_count "kept through probation (062)"
    timestamptz probation_until "062"
    jsonb access_denied_headers "062: allow-listed, scrubbed"
    timestamptz last_refused_at "062"
    bigint unchanged_runs "023"
    timestamptz last_unchanged_at
    timestamptz last_new_post_at "033: newest stored post; source_stale clock"
    timestamptz freshness_anchor_at "037: NOT NULL DEFAULT NOW()"
    timestamptz updated_at
  }

  source_runs {
    uuid id PK
    uuid source_id FK
    uuid job_id FK "nullable"
    text gate_status
    text outcome "ok | error (a skipped source writes no row)"
    int items_fetched
    int posts_new
    int requests
    text error "scrubbed"
    text error_kind "016"
    int http_status "016"
    jsonb response_headers "062: refusal runs only"
    timestamptz started_at
    timestamptz finished_at
  }

  processing_jobs {
    uuid id PK
    text triggered_by "cron | api | standup | manual | demo"
    text status "running | closing | awaiting_retries | completed | failed"
    int posts_collected
    int posts_processed
    int sources_queried
    text error_details
    timestamptz started_at
    timestamptz completed_at
    int inflight_runs "021"
    timestamptz last_progress_at "040: an api, standup, demo or manual job is failed after 30 min without progress"
  }

  alert_events {
    uuid id PK
    text alert_type "bias checks | source_* | retention_overdue | terms_changed | watchdog_* (see NOTE)"
    text severity "warning | critical"
    text source_table "bias_assessments | bias_window_assessments | data_sources | watchdog"
    uuid source_id "not enforced; unique open per type+source (038)"
    jsonb details
    timestamptz acknowledged_at
    text acknowledged_by
    timestamptz resolved_at
    timestamptz created_at
  }

  NOTE_alert_type_values {
    text bias "location_concentration | platform_sentiment_parity | negative_dominance (bias.js; job or 24 h window)"
    text source "source_stale, source_failing (warning), source_refused, retention_overdue (critical), terms_changed (warning)"
    text watchdog "watchdog_ + web_unreachable, db_unreachable, valkey_unreachable, worker_down, maintenance_failing"
    text watchdog_more "retention_overdue, collection_failing, queue_backlog, failed_jobs_abnormal; all critical, one open per type (050)"
    text fixture "bias_violation: written by the e2e fixture only"
  }

  raw_posts {
    uuid id PK
    uuid source_id FK
    text external_id "UNIQUE with source_id"
  }

  reddit_subreddit_rankings {
    uuid id PK
    timestamptz ranked_at
    timestamptz window_start
    timestamptz window_end
    int min_ai_posts
    int top_n
    boolean applied
    text_array selected
    jsonb ranking
    jsonb exclusions
    jsonb stats
  }

  reddit_api_budget {
    smallint id PK "always 1"
    timestamptz window_start
    int used
    timestamptz blocked_until
    real upstream_remaining
    timestamptz upstream_reset_at
    timestamptz updated_at
  }

  reddit_maintenance {
    text job PK "discovery | recheck"
    timestamptz last_started_at
    timestamptz last_completed_at
    text last_outcome
    text last_error_kind
    jsonb last_stats
    timestamptz updated_at
  }

  data_sources ||--o| source_collection_state : "has state"
  data_sources ||--o{ source_runs : "run log"
  processing_jobs |o--o{ source_runs : "job_id, null when no job was open"
  data_sources ||--o{ raw_posts : "source_id"
  alert_events ||..|| NOTE_alert_type_values : "alert_type values"
  alert_events }o..o| data_sources : "per-source alerts (source_table data_sources)"
