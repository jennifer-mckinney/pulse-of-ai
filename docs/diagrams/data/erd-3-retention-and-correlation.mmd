%% Title: Data model 3 of 4 · retention, rollups, correlation, migrations
%% Summary: The GDPR lifecycle log, the monthly rollups and compaction log of the layered retention model, the pseudonymous cross-platform correlation tables (never written: correlateUser throws; the demo purge of compaction only deletes demo sightings and the profiles they leave unreferenced, and recounts the others), the correlation gate log, and the migration ledger.
%% Sources: src/db/migrations/002 (data_retention_log), 005, 006, 036 and 056 (correlation_gate_events, append-only trigger), 070 (relevance_gold_items, relevance_gold_labels: append-only offline gold set; written by src/gold/store.js, erased by gold_erase_post, which src/collectors/retention.js calls in the same transaction as a post's text removal); scripts/migrate.js (schema_migrations). Writers: src/pipeline/ingest.js (collected), src/collectors/retention.js (blanked_platform_terms, text_removed_detail_window), src/collectors/run-retention.js (rolled_up_source_runs), scripts/compact.js (compacted, purged_demo, compaction_log), scripts/correct-legacy-seed-attribution.js (source_reattributed; manual, --apply with GATE_APPROVED_BY), src/collectors/governance.js (correlation_gate_events, with the status from src/pipeline/correlation-gate.js), scripts/compact.js (demo purge of user_platform_sightings and pseudonymous_users); src/pipeline/correlation.js writes nothing (correlateUser throws). Spec: TECHNICAL_SPEC.md sections 19 (layered retention) and 20 (correlation). raw_posts and data_sources are shown with their keys only. Dotted lines are logical links without a foreign key.
erDiagram

  data_retention_log {
    uuid id PK
    uuid raw_post_id "not enforced; NULL on batch rows"
    text action "collected | blanked_platform_terms | text_removed_detail_window | rolled_up_source_runs | compacted | purged_demo | source_reattributed"
    text reason "JSON on batch rows"
    text legal_basis
    timestamptz performed_at
    text performed_by
  }

  monthly_topic_rollups {
    uuid id PK
    date rollup_month
    text topic_label
    text source_category "null = all"
    text location "null = global"
    text language "null = all"
    int post_count
    int positive_count
    int neutral_count
    int negative_count
    real avg_comparative
    real avg_dqi_score
    text_array top_keywords
    timestamptz created_at
  }

  monthly_source_rollups {
    uuid id PK
    date rollup_month "UNIQUE with source_id"
    uuid source_id FK
    text source_category
    int post_count
    int positive_count
    int neutral_count
    int negative_count
    real avg_comparative
    real avg_dqi_score
    timestamptz created_at
  }

  compaction_log {
    uuid id PK
    date compacted_month UK
    int posts_compacted
    int rollups_created
    int embeddings_deleted
    int content_nulled "005 name; holds texts blanked (not nulled)"
    timestamptz completed_at
  }

  pseudonymous_users {
    uuid id PK
    text pseudo_id UK "adjective-animal id"
    text style_cluster_id
    text_array topic_affinity
    int platform_count
    real correlation_confidence
    timestamptz first_sighted_at
    timestamptz last_sighted_at
  }

  user_platform_sightings {
    uuid id PK
    uuid pseudo_user_id FK
    uuid source_id FK
    text signal_hash
    real confidence
    timestamptz sighted_at
  }

  correlation_gate_events {
    uuid id PK
    text status "awaiting_dpia | disabled | misconfigured | unverified | not_implemented"
    boolean enabled "NOT NULL"
    text reason "NOT NULL"
    text dpia_ref
    text actor "NOT NULL; approved_by when named"
    text approved_by
    timestamptz occurred_at "056: append-only (trigger)"
  }

  relevance_gold_items {
    uuid id PK
    text sample_id "NOT NULL"
    uuid raw_post_id "logical link, no FK; NULL once erased"
    text input_hash "HMAC-keyed fingerprint of the text; NULL once erased"
    text category "NOT NULL"
    text scope "filter | ai | unknown"
    text decision "relevant | not_relevant | unscored"
    text stratum "NOT NULL"
    numeric design_weight "NOT NULL"
    text draw_rank "sha256 hex; random once erased"
    timestamptz erased_at "set by gold_erase_post"
  }

  relevance_gold_labels {
    uuid id PK
    bigint seq "GENERATED ALWAYS AS IDENTITY; orders corrections"
    uuid item_id FK "NOT NULL"
    text label "AI_CENTRAL | AI_INCIDENTAL | NOT_AI"
    text method "human | llm_proposed | adjudicated"
    text labeller "NOT NULL; llm: namespace for LLM labels"
    text input_hash "NULL once erased"
    text note "max 200 chars; NULL once erased"
    timestamptz erased_at
  }

  schema_migrations {
    text filename PK "created by scripts/migrate.js"
    timestamptz applied_at
  }

  raw_posts {
    uuid id PK
    uuid source_id FK
    uuid pseudo_user_id FK
  }

  data_sources {
    uuid id PK
  }

  data_retention_log }o..o| raw_posts : "raw_post_id"
  data_sources |o--o{ monthly_source_rollups : "source_id"
  pseudonymous_users ||--o{ user_platform_sightings : "pseudo_user_id"
  data_sources ||--o{ user_platform_sightings : "source_id"
  pseudonymous_users |o--o{ raw_posts : "pseudo_user_id"
  data_sources ||--o{ raw_posts : "source_id"
  relevance_gold_items ||--o{ relevance_gold_labels : "item_id"
  relevance_gold_items }o..o| raw_posts : "raw_post_id"
