%% Title: Collection cycle · part 1 of 3 · schedule, claim and gates
%% Summary: How the worker decides whether a registry source is fetched at all: its job scheduler, the gate status, the database kill switch, the refused state and the poll-interval claim.
%% Sources: src/workers/collector.scheduler.js, src/workers/collect.worker.js, src/collectors/runner.js, src/config/source-registry.js (sourceStatus, openRoutes, killReason), src/collectors/state.js, src/collectors/refusal.js. Spec: TECHNICAL_SPEC.md section 17; ADR 0001 (kill switches, refused state, D1).
flowchart LR

  subgraph START["Schedule"]
    direction TB
    S1["1 · collector.scheduler<br/>at worker start and every 10 min:<br/>one BullMQ job scheduler per source<br/>whose gate status is collecting"]:::done
    S2["2 · cadence: every max(COLLECT_WINDOW_MS,<br/>the source's poll interval), default 150 s;<br/>start times staggered across the window;<br/>schedulers of sources no longer collecting removed"]:::done
    S3["3 · job on collect.rss / collect.api / collect.bulk<br/>processCollectJob(slug) → runCollection<br/>with the cycle option, deadline = half the window"]:::done
    S4["4 · resolveCurrentMethodology()<br/>sentiment@1.0.0 · relevance@1.1.0<br/>discourse@1.1.0-DQI · bias@1.1.0 · ingest@1.5.0"]:::done
    S1 --> S2 --> S3 --> S4
  end

  subgraph GATE["Gate status · sourceStatus(src, env)"]
    direction TB
    G1{"5 · env kill switch?<br/>COLLECTORS_ENABLED=false, slug in<br/>COLLECTORS_DISABLED, or<br/>SOURCE_#lt;SLUG#gt;_ENABLED=false"}:::done
    G2{"6 · auth kind blocked<br/>and no route open?"}:::done
    G3{"7 · COLLECTOR_CONTACT_URL set?<br/>(empty on a fresh clone, D1)"}:::done
    G4{"8 · a route open? every env var in<br/>route.requires set: credentials,<br/>approval or licence refs, and<br/>PERMISSION_GATED_FEEDS_ACCEPTED_BY<br/>for the 8 permission-gated feeds"}:::done
    G1 -- no --> G2
    G2 -- no --> G3
    G3 -- yes --> G4
  end

  subgraph RUNTIME["Runtime checks · runner.js"]
    direction TB
    R1{"9 · collection deadline<br/>already reached?"}:::done
    R2{"10 · database kill switch?<br/>data_sources.collection_disabled_at<br/>(npm run source:disable)"}:::done
    R3{"11 · refused state?<br/>source_collection_state<br/>access_denied_at, refused_until"}:::done
    R4["SOURCE_#lt;SLUG#gt;_RESET date newer<br/>than the refusal: clearRefusal()"]:::done
    R5{"12 · claim: last attempt older than<br/>the poll interval? (state.claim,<br/>atomic across worker and refresh)"}:::done
    R1 -- no --> R2
    R2 -- no --> R3
    R3 -- "reset by env" --> R4 --> R5
    R3 -- "none, or one probe<br/>after the cooldown" --> R5
  end

  subgraph OUT["Skipped, nothing fetched"]
    direction TB
    O1["disabled"]:::done
    O2["blocked (the blocked 4)"]:::done
    O3["closedStatus: awaiting_key /<br/>awaiting_approval / awaiting_licence"]:::done
    O4["skipped: deadline reached"]:::done
    O5["blocked_by_source<br/>cooldown min(1 h × 2^(n−1), 24 h)"]:::done
    O6["skipped: collected within its<br/>poll interval (rate limit)"]:::done
  end

  NEXT["→ part 2: fetch, normalise,<br/>store and score"]:::done

  subgraph LEGEND["Status legend"]
    L1["done: on master or ships in this PR"]:::done
  end

  S4 --> G1
  G1 -- yes --> O1
  G2 -- yes --> O2
  G3 -- no --> O1
  G4 -- no --> O3
  G4 -- yes --> R1
  R1 -- yes --> O4
  R2 -- yes --> O1
  R3 -- "in cooldown" --> O5
  R5 -- no --> O6
  R5 -- yes --> NEXT

