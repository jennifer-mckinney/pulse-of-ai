%% Title: Collection cycle · part 1 of 3 · schedule, claim and gates
%% Summary: How the worker decides whether a registry source is fetched at all: its job scheduler and the recorded gate transitions, the gate status (including the named approval a gated route needs, decision G5), the database kill switch, the refused state and the poll-interval claim.
%% Sources: src/workers/collector.scheduler.js, src/workers/collect.worker.js, src/collectors/runner.js, src/config/source-registry.js (sourceStatus, openRoutes, namedApproval, killReason), src/config/methodology-registry.js (CURRENT_VERSIONS), src/collectors/state.js, src/collectors/refusal.js, src/collectors/governance.js (recordGateTransitions, recordGateEvent), scripts/source-admin.js; migrations 018, 020, 035, 056. Spec: TECHNICAL_SPEC.md section 17; ADR 0001 (kill switches, refused state, D1); PR #22 decision G5.
flowchart LR

  subgraph START["Schedule"]
    direction TB
    S1["1 · collector.scheduler<br/>at worker start and every 10 min:<br/>one BullMQ job scheduler per source<br/>whose gate status is collecting"]:::done
    SG["each reschedule also records gate changes:<br/>recordGateTransitions() → append-only<br/>source_gate_events gate_opened / gate_closed,<br/>approved_by = GATE_APPROVED_BY for a gated<br/>opening; the database kill switch counts as closed;<br/>correlation gate changes → correlation_gate_events"]:::done
    S2["2 · cadence: every max(COLLECT_WINDOW_MS,<br/>the source's poll interval), default 150 s;<br/>start times staggered across the window;<br/>schedulers of sources no longer collecting removed"]:::done
    S3["3 · job on collect.rss / collect.api / collect.bulk<br/>processCollectJob(slug) → runCollection<br/>with the cycle option, scoreVia queue,<br/>deadline = half the window"]:::done
    S4["4 · resolveCurrentMethodology()<br/>sentiment@1.0.0 · relevance@1.2.0<br/>discourse@1.1.0-DQI · bias@1.6.0<br/>ingest@1.7.0 · admission_filter@1.0.0"]:::done
    S1 --> SG
    S1 --> S2 --> S3 --> S4
  end

  subgraph GATE["Gate status · sourceStatus(src, env)"]
    direction TB
    G1{"5 · env kill switch?<br/>COLLECTORS_ENABLED=false, slug in<br/>COLLECTORS_DISABLED, or<br/>SOURCE_#lt;SLUG#gt;_ENABLED=false"}:::done
    G2{"6 · auth kind blocked, no route<br/>open and none awaiting approval?"}:::done
    G3{"7 · COLLECTOR_CONTACT_URL set?<br/>(empty on a fresh clone, D1)"}:::done
    G4{"8 · a route open? every env var in<br/>route.requires set: credentials,<br/>approval or licence refs, and<br/>PERMISSION_GATED_FEEDS_ACCEPTED_BY<br/>for the 8 permission-gated feeds;<br/>a gated route (any requires) also<br/>needs a valid GATE_APPROVED_BY"}:::done
    G5{"G5 · a gated route configured<br/>but GATE_APPROVED_BY missing or<br/>not #quot;Name YYYY-MM-DD#quot;?"}:::done
    G1 -- no --> G2
    G2 -- no --> G3
    G3 -- yes --> G4
    G4 -- no --> G5
  end

  subgraph RUNTIME["Runtime checks · runner.js"]
    direction TB
    R1{"9 · collection deadline<br/>already reached?"}:::done
    R2{"10 · database kill switch?<br/>data_sources.collection_disabled_at<br/>(npm run source:disable, refused<br/>without GATE_APPROVED_BY)"}:::done
    R3{"11 · refused state?<br/>source_collection_state<br/>access_denied_at, refused_until"}:::done
    R4["SOURCE_#lt;SLUG#gt;_RESET date at or after the<br/>last refusal and a valid GATE_APPROVED_BY:<br/>clearRefusal() + source_gate_events<br/>refusal_reset, one transaction"]:::done
    R5{"12 · claim: last attempt older than<br/>the poll interval, less a jitter slack<br/>(at most 20 %)? (state.claim,<br/>atomic across worker and refresh)"}:::done
    R1 -- no --> R2
    R2 -- no --> R3
    R3 -- "reset by env" --> R4 --> R5
    R3 -- "none, or one probe<br/>after the cooldown" --> R5
  end

  subgraph OUT["Skipped, nothing fetched"]
    direction TB
    O1["disabled"]:::done
    O2["blocked (the blocked 4)"]:::done
    O7["closedStatus, reason<br/>#quot;awaiting named approval#quot;"]:::done
    O3["closedStatus: awaiting_key /<br/>awaiting_approval / awaiting_licence<br/>(permission-gated feed without the<br/>acknowledgement, or keys missing)"]:::done
    O4["skipped: deadline reached"]:::done
    O5["blocked_by_source<br/>cooldown min(1 h × 2^(n−1), 24 h)"]:::done
    O6["skipped: collected within its<br/>poll interval (rate limit)"]:::done
  end

  NEXT["→ part 2: fetch, normalise,<br/>store and hand to scoring"]:::done

