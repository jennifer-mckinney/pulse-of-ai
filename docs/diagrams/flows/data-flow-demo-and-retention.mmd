%% Title: Data flow · demo population and retention
%% Summary: The demo fallback path (fictional posts through the real scorers, labelled DEMO end to end) and the three retention flows: Reddit 48-hour text blanking, the demo purge and monthly compaction.
%% Sources: scripts/populate.js, scripts/standup.sh, src/config/data-mode.js, src/collectors/retention.js, src/collectors/reddit/{maintenance,recheck}.js, scripts/compact.js, src/db/migrations/005_retention_tables.sql, 025_reddit_source.sql. Spec: TECHNICAL_SPEC.md section 19 (layered retention); ADR 0001 ruling 9.
flowchart LR

  subgraph DEMO["Demo population · scripts/populate.js"]
    direction TB
    M1["standup: populate --once<br/>(populate container, collector settings only)<br/>one real collection job, triggered_by standup;<br/>no credentials, so keyless and ack-gated routes only"]:::done
    M2{"trailing hour holds<br/>live posts?"}:::done
    M3["demo batch (skipped when the hour<br/>already holds --size demo posts, unless --force)"]:::done
    M4["populate --loop (profile demo)<br/>every DEMO_FEED_INTERVAL_MS (150 s):<br/>DEMO_FEED_BATCH posts (default 16,<br/>two per category) only while the hour has no live posts"]:::done
    M5["fictional posts: text starts with [Demo],<br/>raw_payload demo: true, fictional: true,<br/>under data_sources demo_#lt;category#gt;<br/>(source_type demo, active false)"]:::done
    M6["normalisePost → raw_posts (collected_at = now)<br/>→ saveSentiment / saveRelevance / saveDQI<br/>with audit rows → runBiasChecks<br/>→ embed jobs; processing_jobs triggered_by demo"]:::done
    M7["labelled on the way out: data_mode on /api/health,<br/>demo_posts + data_mode per city row,<br/>data_origin on receipts → DEMO kicker,<br/>Demo data markers, demo receipt wording"]:::done
    M8["no demo post written;<br/>the page reads LIVE"]:::done
    M1 --> M2
    M2 -- yes --> M8
    M2 -- no --> M3 --> M5
    M4 --> M2
    M5 --> M6 --> M7
  end

  subgraph REDDIT["Reddit text blanking · ADR 0001 ruling 9"]
    direction TB
    R1["worker: Reddit maintenance every 5 min<br/>blankExpired() always, whatever the gate"]:::done
    R2["recheckDeletions() every 6 h via /api/info,<br/>only while Reddit's gate is open"]:::done
    R3["raw_posts.content and payload text/title<br/>→ [removed: Reddit Data API Terms retention];<br/>permalink cut to the slug-less form;<br/>text_removed_at, text_removed_reason set"]:::done
    R4["kept: row, t3_ id, provenance fingerprint,<br/>content hash, every score and audit row"]:::done
    R5["one data_retention_log row per batch,<br/>action blanked_platform_terms"]:::done
    R1 -- "collected 48 h ago" --> R3
    R2 -- "deleted or removed upstream" --> R3
    R3 --> R4
    R3 --> R5
  end

  subgraph COMPACT["npm run compact · scripts/compact.js (run by hand)"]
    direction TB
    P1["demo purge first: demo posts older than<br/>RETENTION_DETAIL_DAYS (90) deleted in batches<br/>(DEMO_PURGE_BATCH_SIZE, 500) with their score,<br/>audit, embedding and sighting rows;<br/>data_retention_log action purged_demo"]:::done
    P2["compaction: each month older than 90 days<br/>not yet in compaction_log →<br/>monthly_topic_rollups + monthly_source_rollups<br/>(demo posts excluded)"]:::done
    P3["delete post_embeddings of the month"]:::done
    P4["null raw_posts.content: blocked today,<br/>the column is NOT NULL (migration 001);<br/>compaction cannot complete on a real month"]:::done
    P5["data_retention_log action compacted,<br/>one compaction_log row per month"]:::done
    P1 --> P2 --> P3 --> P4 --> P5
  end

  subgraph WIP["PR #10 Part 2"]
    direction TB
    W1["scheduled compaction in the worker"]:::wip
    W2["per-source retention windows"]:::wip
  end

  subgraph LEGEND["Status legend"]
    L1["done: on master"]:::done
    L2["wip: PR #10 Part 2, in flight"]:::wip
  end

  P5 -.-> W1
  R1 -.-> W2

