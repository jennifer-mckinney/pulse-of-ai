%% Title: Object model · collector framework
%% Summary: The collector base classes and their adapters by type, the HTTP client and its guards, the Reddit API helpers, and the module functions the runner, cycle, state, gate governance, source health and retention layers expose.
%% Sources: src/collectors/{base,index,http,robots,netguard,transport,errors,runner,cycle,state,refusal,status,retention,normalize,identity,provenance,redact,ai-filter,governance,terms-text,source-health,source-alerts,retention-overdue,run-retention,stale-jobs,sweep}.js, src/collectors/adapters/*.js, src/collectors/reddit/{api,budget}.js, src/config/source-registry.js. Spec: ADR 0001 (strategy / adapter pattern, gate status); TECHNICAL_SPEC.md section 17.
classDiagram
  direction LR

  class Collector {
    <<abstract, base.js>>
    +source
    +route
    +env
    +http HttpClient
    +cursor
    +httpCache
    +warnings
    +robotsGated$ false
    +constructor(ctx) throws GateClosedError
    +envUrl(name) string
    +requestOptions(extra) object
    +get(url, extra)
    +getJson(url, extra)
    +fetchItems()* items
    +warn(text, err)
    +collect() payloads, fetched, dropped, warnings
  }
  class RssAtomCollector {
    +robotsGated$ true
    +feedUrls() string[]
    +parse(xml) feed
    +fetchItems() items
  }
  class JsonApiCollector {
    +envValue(name) string
  }
  class BulkFileCollector {
    +pathEnv string
    +mapRecord(rec) item
    +accepts(rec) boolean
    +listFiles() string[]
    +fetchItems() items
  }
  Collector <|-- RssAtomCollector
  Collector <|-- JsonApiCollector
  Collector <|-- BulkFileCollector
  Collector <|-- ScholarImapCollector

  class RssAdapters {
    <<RssAtomCollector subclasses>>
    ArxivCollector
    LicensedFeedCollector
    WeChatAuthorizedFeedCollector blocked
    CatoAllowlistedRssCollector blocked
  }
  class ApiAdapters {
    <<JsonApiCollector subclasses>>
    YouTube, TikTokResearch, XRecentSearch
    NytArticleSearch, GuardianContentApi, ApMedia, ReutersConnect
    Pubmed, Springer, Elsevier, Ieee
    GovinfoSearch, Congress, Pew
    WikipediaTalk, InternetArchive
    GithubSearch, GitlabProjects, DockerHubNamespace, HfDailyPapers, Discourse
    StackExchange, HnAlgolia, RedditCollector
    TelegramBotApiCollector blocked
  }
  class BulkAdapters {
    <<BulkFileCollector subclasses>>
    MetaContentLibraryCollector
    JstorDatasetCollector
    ResearchGateGrantedDatasetCollector blocked
  }
  class ScholarImapCollector {
    <<academic.js, IMAP mailbox>>
    +fetchItems() items
  }
  RssAtomCollector <|-- RssAdapters
  JsonApiCollector <|-- ApiAdapters
  BulkFileCollector <|-- BulkAdapters

  class HttpClient {
    <<http.js>>
    +requests number
    +constructor(o: transport, env, limiter, sleep, timeoutMs 20000, robotsCache, signal)
    +request(url, o) response
    +json(url, o) object
    +text(url, o) response
    +fetchRobots(url)
    +checkDeadline()
  }
  class HostLimiter {
    +wait(host, minIntervalMs)
  }
  class RobotsPolicy {
    <<robots.js, cached 24 h, unreachable 10 min>>
    +policyFor(origin)
    +check(url, opts) allowed
  }
  class netguard {
    <<module>>
    +checkUrl(url, o: allowedHosts) URL
    +isBlockedAddress(ip)
    +createGuardedLookup(dnsLookup)
    +hostAllowed(host, allowedHosts)
  }
  class transport {
    <<module>>
    +createNetworkTransport(o: request, lookup)
    DEFAULT_MAX_BYTES 5 MB
    ROBOTS_MAX_BYTES 500 KiB
  }
  Collector --> HttpClient : every request
  HttpClient --> HostLimiter
  HttpClient --> RobotsPolicy
  HttpClient --> netguard : every hop
  HttpClient --> transport : default transport

  class CollectorError {
    <<errors.js>>
    +kind
    +status
  }
  class ErrorTypes {
    <<CollectorError subclasses>>
    AccessDeniedError
    RobotsDisallowedError
    GateClosedError
    HttpError
    ParseError
    HostRefusedError
    RedirectRefusedError
    ResponseTooLargeError
    BudgetExhaustedError
    ResponseDecodeError
  }
  CollectorError <|-- ErrorTypes

  class RedditApi {
    <<reddit/api.js, OAuth app-only>>
    +grant()
    +token()
    +get(path, params)
    +listing(path, params)
    +about(subreddit)
    +info(fullnames)
  }
  class DbBudget {
    <<reddit/budget.js, reddit_api_budget>>
    +take(o: reserve) boolean
    +observe(headers)
  }
  ApiAdapters ..> RedditApi : RedditCollector
  RedditApi --> DbBudget

  class runner {
    <<module runner.js>>
    +runCollection(o) summary
    +defaultQueues()
  }
  class index {
    <<module index.js>>
    +ADAPTERS
    +buildCollectors(source, ctx) Collector[]
  }
  class sourceRegistry {
    <<module config/source-registry.js>>
    +SOURCES 52
    +GATE_STATUSES
    +GATE_APPROVAL_ENV GATE_APPROVED_BY
    +getSource(slug)
    +sourceStatus(src, env)
    +openRoutes(src, env)
    +namedApproval(env) ok, value
    +isGatedRoute(route)
    +routesAwaitingApproval(src, env)
    +killSwitchEnv(slug)
    +retentionHours(src, env)
    +retentionDetailDays(env)
    +pollIntervalSec(src, env)
    +collectWindowMs(env)
    +routeAllowedHosts(route, env)
    +attributionFor(slug)
  }
  class state {
    <<module state.js>>
    +claim(sourceId, minIntervalSec, windowMs)
    +saveOutcome(sourceId, o)
    +recordRun(o)
    +countUnchangedRun(sourceId)
    +dbKillSwitch(sourceId)
    +setDbKillSwitch(sourceId, disabled, o: reason, by, client)
    +getRefusal(sourceId)
    +recordRefusal(sourceId, refusal, slug)
    +clearRefusal(sourceId, resolution, o: client)
    +endCooldown(sourceId, probedDeniedAt) probe ok: 24 h probation, count kept
    +decayRefusal(sourceId) count to 0 after probation
  }
  class cycle {
    <<module cycle.js>>
    +currentCycleJob(windowMs)
    +joinCycle(jobId, windowMs)
    +retryJobFor(jobId, windowMs)
    +leaveCycle(jobId, counts)
    +reserveRetry / releaseRetry(jobId)
    +closeCycles(windowMs) runs bias checks
  }
  class refusal {
    <<module refusal.js>>
    +refusalGate(row, slug, env, now) reset, cooldown, probe
    +envReset(slug, env, deniedAt) date AND named approval
    +refusalOf(classified)
    +cooldownMs(n)
    +probationOver(row, now)
    +resetEnv(slug)
  }
  class status {
    <<module status.js>>
    +sourceRows(o)
    +summarize(rows)
    +isOnline(status, lastSuccessAt, now, lastErrorAt)
    +registryFields(row, env, now)
    +RUNTIME_STATUSES gate statuses + blocked_by_source
  }
  class normalize {
    <<module normalize.js + identity.js + provenance.js>>
    +toPayload(item, source, route, o: key)
    +redactIdentities(text)
    +redactText(text)
    +isIdentityUrl(url)
    +provenanceFingerprint(key, slug, rawId, url)
    +storedExternalId(routeId, rawId, key)
  }
  class retention {
    <<module retention.js, text blanked never nulled>>
    +REMOVAL_NOTICE, DETAIL_NOTICE
    +retentionSources()
    +blankExpired(o: batchSize, log, env)
    +blankPosts(slug, postIds, o: reason)
    +blankPlatformPosts(client, slug, postIds, o)
    platform-terms blanking also deletes the embedding
    +removeTextBatch(client, slug, postIds, o)
    +postsWithText(slug)
    +retentionStatus(slug, o)
  }
  class aiFilter {
    <<module ai-filter.js, admission_filter@1.0.0>>
    +isAiRelated(text) boolean
    +PATTERNS, SEARCH_TERMS
    +ADMISSION_FILTER_VERSION
    +patternDescriptions()
  }
  class governance {
    <<module governance.js, source_gate_events>>
    +recordGateEvent(o) event, actor, approvedBy
    +recordGateTransitions(o: env, actor) events
    +recordCorrelationGate(o: env, actor)
    +snapshotTerms(o: http, slugs, log) rows
    +saveTermsSnapshots(rows) saved, changed
    +SCHEDULER_ACTOR
  }
  class termsText {
    <<module terms-text.js>>
    +normaliseTermsText(body, contentType)
    +sha256(text)
  }
  class sourceHealth {
    <<source-health + source-alerts + retention-overdue>>
    +evaluateSourceHealth(o: env, now) opened, resolved
    +conditionsFor(row, src, now)
    +TYPES source_stale, source_failing, source_refused
    +openSourceAlert(type, severity, sourceId, details, client)
    +resolveSourceAlert(type, sourceId, o, outer)
    +evaluateRetentionOverdue(o: env) critical retention_overdue
    +overdueBySource(o: env)
  }
  class housekeeping {
    <<modules stale-jobs.js + run-retention.js + sweep.js>>
    +sweepStaleJobs(o: env)
    +rollupSourceRuns(o: env, batch) to source_run_daily
    +sweepUnscored(o: enqueue, isPending, now, limit)
    +pendingJobIds(rawPostId, bucket)
  }
  class redact {
    <<module redact.js>>
    +redactUrl(url)
    +scrub(text, env)
  }
  runner --> sourceRegistry
  runner --> state
  runner --> refusal
  runner --> index
  runner --> cycle
  runner --> redact
  runner --> governance : refusal_reset event
  index --> Collector : builds one per open route
  Collector --> normalize : collect()
  Collector --> aiFilter : scope filter routes
  governance --> sourceRegistry
  governance --> termsText
  sourceHealth --> sourceRegistry
  refusal --> sourceRegistry : namedApproval
  status --> sourceRegistry
  status --> refusal
