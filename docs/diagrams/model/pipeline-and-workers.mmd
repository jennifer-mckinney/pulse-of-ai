%% Title: Object model · pipeline modules, workers and queues
%% Summary: The scoring pipeline modules and what each exports, the methodology resolver, the BullMQ queues and the worker handlers that consume them, and the audit replay module.
%% Sources: src/pipeline/*.js, src/queues/{index,connection}.js, src/workers/*.js, src/audit/replay.js, src/config/methodology-registry.js. Spec: TECHNICAL_SPEC.md sections 9, 10, 12, 18, 20. Versions are CURRENT_VERSIONS of the methodology registry.
classDiagram
  direction LR

  class ingest {
    <<module pipeline/ingest.js · ingest@1.5.0>>
    +PII_FIELDS
    +normalisePost(rawPayload, sourceType)
    +storeRawPost(payload, sourceId, ingestMvId) postId, isNew
    +scorePost(postId, jobId, mvIds) sentiment, relevance, discourse
    +ingestPost(payload, sourceId, jobId, mvIds)
    +ingestBatch(payloads, sourceId, jobId, mvIds)
  }
  class sentiment {
    <<module pipeline/sentiment.js · sentiment@1.0.0>>
    +POSITIVE_THRESHOLD 0.05
    +NEGATIVE_THRESHOLD -0.05
    +computeSentiment(text)
    +saveSentiment(postId, jobId, mvId)
  }
  class relevance {
    <<module pipeline/relevance.js · relevance@1.1.0>>
    +KEYWORD_LIST 20 terms
    +EMBED_GATE_MIN_SCORE 1/20
    +computeRelevance(text)
    +saveRelevance(postId, jobId, mvId)
    +passesEmbedGate(score)
  }
  class discourse {
    <<module pipeline/discourse.js · discourse@1.1.0-DQI>>
    +DQI_DIMENSIONS 5: participation, justification,
    respectfulness, constructiveness, evidence
    +computeDQI(text)
    +saveDQI(postId, jobId, mvId)
  }
  class bias {
    <<module pipeline/bias.js · bias@1.1.0>>
    +runBiasChecks(jobId, biasMvId) checksRun 3, violationsFound
    +checkLocationConcentration(jobId, biasMvId)
    +checkPlatformSentimentParity(jobId, biasMvId)
    +checkNegativeDominance(jobId, biasMvId)
  }
  class embeddings {
    <<module pipeline/embeddings.js · embedding@1.0.0>>
    +EMBEDDING_DIMENSIONS 384
    +generateEmbedding(text)
    +saveEmbedding(postId, embedding, modelName)
    +embedPost(postId)
    +embeddingMethodologyVersion(env)
  }
  class correlation {
    <<module pipeline/correlation.js · reserved>>
    +CORRELATION_MIN_CONFIDENCE 0.85
    +generatePseudoId(seed)
    +computeSignalHash(signals, salt)
    +correlateUser(o)
  }
  class methodology {
    <<module pipeline/methodology.js>>
    +PIPELINE_COMPONENTS
    +resolveCurrentMethodology() mv ids
  }
  class replay {
    <<module audit/replay.js>>
    +STATUS PASS, DIVERGENCE, NOT RE-RUNNABLE
    +replayDecision(content, decision, removal)
    +replayPost(post, decisions) report
    +formatReport(report)
  }
  ingest --> sentiment
  ingest --> relevance
  ingest --> discourse
  replay --> sentiment : re-run
  replay --> relevance : re-run
  replay --> discourse : re-run

  class Queues {
    <<queues/index.js · BullMQ on Redis>>
    collect.rss, collect.api, collect.bulk attempts 1
    collect.refresh attempts 1
    ingest attempts 5, backoff 1 s
    embed attempts 5, backoff 2 s
    correlate attempts 5
  }
  class WorkerProcess {
    <<workers/start.js>>
    collect.rss / collect.api concurrency 4 each
    collect.bulk, collect.refresh concurrency 1
    ingest 20 · embed 4 · correlate 8
    +schedule() every 10 min
    +closeDueCycles() every 30 s
    +redditMaintenance() every 5 min
    +startHeartbeat() every 15 s
    +shutdown() on SIGTERM / SIGINT
  }
  class collectWorker {
    <<workers/collect.worker.js>>
    +processCollectJob(job) run summary
    +processRefreshJob(job) run summary
  }
  class scheduler {
    <<workers/collector.scheduler.js>>
    +scheduleAllSources(env, log) count
  }
  class ingestWorker {
    <<workers/ingest.worker.js>>
    +processIngestJob(job)
    +onIngestJobFailed(job)
  }
  class embedWorker {
    <<workers/embed.worker.js>>
    +processEmbedJob(job)
  }
  class correlateWorker {
    <<workers/correlate.worker.js · nothing enqueues it>>
    +processCorrelateJob(job)
  }
  class heartbeat {
    <<workers/heartbeat.js + healthcheck.js>>
    +HEARTBEAT_KEY pulse:worker:heartbeat
    +beat(redis)
    +readHeartbeat(redis) alive, last_heartbeat
    +fileIsFresh(file, maxAgeMs)
  }
  WorkerProcess --> collectWorker
  WorkerProcess --> ingestWorker
  WorkerProcess --> embedWorker
  WorkerProcess --> correlateWorker
  WorkerProcess --> scheduler
  WorkerProcess --> heartbeat
  Queues <.. WorkerProcess : consumes
  scheduler ..> Queues : upsertJobScheduler
  collectWorker ..> ingest : via collectors/runner
  collectWorker ..> bias : via runner (refresh jobs)
  WorkerProcess ..> bias : closeDueCycles → cycle close
  ingestWorker --> ingest : scorePost
  ingestWorker --> relevance : passesEmbedGate
  ingestWorker --> methodology
  embedWorker --> embeddings
  correlateWorker --> correlation
  collectWorker ..> methodology
