  class Queues {
    <<queues/index.js · BullMQ on Valkey>>
    collect.rss, collect.api, collect.bulk attempts 1
    collect.refresh attempts 1
    ingest attempts 5, backoff 1 s
    embed attempts 5, backoff 2 s
    correlate attempts 5
    maintenance attempts 1
  }
  class WorkerProcess {
    <<workers/start.js>>
    concurrency: collect.rss 4, collect.api 4
    concurrency: collect.bulk 1, collect.refresh 1
    concurrency: ingest 8, embed 4, correlate 8
    concurrency: maintenance 1
    30 s tick: cycles, source health
    30 s tick: retention overdue, unscored sweep
    +schedule() every 10 min, also scheduleMaintenance
    +closeDueCycles() every 30 s
    +redditMaintenance() every 5 min
    +startHeartbeat() every 15 s
    +shutdown() on SIGTERM / SIGINT
  }
  class collectWorker {
    <<workers/collect.worker.js>>
    +processCollectJob(job) run summary, scoreVia queue
    +processRefreshJob(job) run summary, scoreVia queue
    +refreshDeadlineMs(env)
  }
  class scheduler {
    <<workers/collector.scheduler.js>>
    +scheduleAllSources(o: env, log) count
    each run also records gate + correlation gate events
  }
  class maintenanceWorker {
    <<workers/maintenance.worker.js>>
    retention every 5 min: text retention, stale jobs
    daily every 24 h: compaction, source_runs rollup, bias_window
    terms every 7 days: terms snapshots
    +processMaintenanceJob(job, o) steps
    +scheduleMaintenance(queue, env)
    +recordMaintenanceRun(task, out) maintenance_state
  }
  class ingestWorker {
    <<workers/ingest.worker.js>>
    +processIngestJob(job)
    +onIngestJobFailed(job)
  }
  class embedWorker {
    <<workers/embed.worker.js · enqueues no correlate job>>
    +processEmbedJob(job, o: env)
  }
  class correlateWorker {
    <<workers/correlate.worker.js · nothing enqueues it>>
    +processCorrelateJob(job, o: env) refused with the gate status
  }
  class heartbeat {
    <<workers/heartbeat.js + healthcheck.js>>
    +HEARTBEAT_KEY pulse:worker:heartbeat, TTL 90 s
    +CORRELATION_KEY pulse:worker:correlation
    +beat(redis, o: correlation)
    +startHeartbeat(redis, o) stop()
    +readHeartbeat(redis) alive, last_heartbeat
    +readCorrelationStatus(redis)
    +fileIsFresh(file, maxAgeMs)
  }
  WorkerProcess --> collectWorker
  WorkerProcess --> ingestWorker
  WorkerProcess --> embedWorker
  WorkerProcess --> correlateWorker
  WorkerProcess --> maintenanceWorker
  WorkerProcess --> scheduler
  WorkerProcess --> heartbeat
  Queues <.. WorkerProcess : consumes
  scheduler ..> Queues : upsertJobScheduler
  maintenanceWorker ..> Queues : upsertJobScheduler x3
  collectWorker ..> Queues : one ingest job per new post
  WorkerProcess ..> bias : closeDueCycles, cron cycles and awaiting_retries jobs
  maintenanceWorker --> biasWindow : daily
  ingestWorker --> ingest : scorePost
  ingestWorker --> relevance : passesEmbedGate
  ingestWorker --> methodology
  embedWorker --> embeddings
  embedWorker --> correlationGate : status only
  correlateWorker --> correlationGate
  heartbeat ..> correlationGate : publishes status
  collectWorker ..> methodology

  class Watchdog {
    <<watchdog/index.js · own container, scripts/watchdog.js>>
    every WATCHDOG_POLL_INTERVAL_S 120 s
    +init()
    +pollOnce() open conditions
    +run()
    +stop()
  }
  class watchdogParts {
    <<watchdog/conditions.js + store.js + notifier.js + config.js>>
    +evaluate(probe, o) 9 CONDITIONS
    +store: openAlert, resolveAlert, writeState, recordNotification
    +Notifier: enqueue(ev), deliver() SMTP, rate-limited
    +readConfig(env)
  }
  Watchdog --> watchdogParts
  Watchdog ..> heartbeat : reads worker liveness via /api/health
